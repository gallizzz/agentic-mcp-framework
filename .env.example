# Google Gemini API Key & Model Configuration
GEMINI_API_KEY=your_google_ai_studio_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest

# AsmetaS Formal Gate Network Endpoint
ASMETAS_URL=http://localhost:8080

# Case study to load from use_cases/<name>/config.py (required)
USE_CASE=vehicle

# NOTE: Domain mappings, ASM model names, MCP commands, and safety policies
# are configured per use case in use_cases/<name>/config.py.