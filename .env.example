# Google Gemini API Key & Model Configuration
GEMINI_API_KEY=your_google_ai_studio_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest

# AsmetaS Formal Gate Configuration
ASMETAS_URL=http://localhost:8080
ASMETA_MODEL_NAME=SafetyEnforcerModel.asm
GUARD_AGENT_CARD_PATH=mcp_server/asmetas/agent-card.json

# Pluggable Environment MCP Server Configuration
# 1. Via A2A Agent Card:
ENVIRONMENT_AGENT_CARD_PATH=mcp_server/vehicle/agent-card.json
# 2. Or via direct command/args:
# ENVIRONMENT_MCP_COMMAND=python
# ENVIRONMENT_MCP_ARGS=mcp_server/vehicle/vehicle_mcp_server.py

# Optional Action and Variable Mappings between Environment & ASM Model
ACTION_MAPPING={"KEEP": "IDLE"}
DEFAULT_MONITORED_VARIABLES={"rightLaneFree": "false"}

# Optional: Custom System Prompt override
# SYSTEM_PROMPT=Sei un assistente intelligente...