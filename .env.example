# Google Gemini API key and model (both required, no defaults)
GEMINI_API_KEY=your_google_ai_studio_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# AsmetaS-web-service URL (required, the only place where the address is defined)
ASMETAS_URL=http://localhost:8080

# Case study to load from use_cases/<name>/config.py (required)
USE_CASE=pillbox

# NOTE: The MCP server command, the ASM models and the planner instructions
# are configured per use case in use_cases/<name>/.